DATABASE_URL=postgresql://drinkarto:drinkarto_local@localhost:5432/drinkarto
APP_ORIGIN=http://localhost:3000
AI_MODEL=
OPENAI_API_KEY=

# Separate official-price worker: Python with pdfplumber and curl required
PRICE_PYTHON=python3
PRICE_REFRESH_HOURS=3

# Explicit platform reviewers only; tenant ownership does not grant global publishing.
PRICE_REVIEWER_USER_IDS=

# Optional PostgreSQL pool sizing
DB_POOL_MAX=5

# Optional LocalPour live venue discovery; enable Geocoding and Places API (New).
GOOGLE_MAPS_SERVER_KEY=
# Optional private review photo storage; bucket must be private: localpour-private
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
